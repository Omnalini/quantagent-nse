# One LLM key is required to run live analysis.
# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# or Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_value

# Set to 1 only on a trusted local machine — enables the Werkzeug debugger.
FLASK_DEBUG=0
